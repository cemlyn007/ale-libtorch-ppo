"""
ALE libtorch PPO
"""
module(
    name = "ale_libtorch_ppo",
    version = "0.1.0",
)

bazel_dep(name = "protobuf", version = "33.4")

bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_foreign_cc", version = "0.15.0")

tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
tools.cmake(version = "3.31.1")

bazel_dep(name = "zlib", version = "1.3.1.bcr.6")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "arcade_learning_environment",
    urls = ["https://github.com/Farama-Foundation/Arcade-Learning-Environment/archive/refs/tags/v0.11.1.tar.gz"],
    strip_prefix = "Arcade-Learning-Environment-0.11.1",
    build_file = "//third_party:ale.BUILD",
    integrity = "sha256-K4eK4bf+u0mMerU1F5HG2YONwhS0gl7sDfG1O1i2qqM=",
)

bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "tensorboard_logger")
git_override(
    module_name = "tensorboard_logger",
    # Bazel 9-compatible: loads proto/cc rules explicitly and declares its own
    # rules_cc dep, so the old patch is no longer needed.
    commit = "50889bf5c6502828a50a5a25edd2ca0b72f6f4cc",
    remote = "https://github.com/cemlyn007/tensorboard_logger.git",
)

bazel_dep(name = "stb", version = "0.0.0-20241109-5c20573")

libtorch_extension = use_extension("//third_party:libtorch.bzl", "libtorch_configure_extension")
libtorch_extension.configure(
    version = "2.12.0",  # Specify your desired version here
)
use_repo(libtorch_extension, "libtorch")

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    # Bazel 9-compatible fork: loads its rules from @rules_python/@rules_cc and
    # handles sourceless (parse_headers) compile actions, replacing our old patch.
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
    commit = "26a1ba52bd76aa3d95fa7278a9696d51f7946612",
)

# 0.9.0 loads its rules via @rules_cc and includes <cstdint> itself, dropping
# the autoload workaround and force-include patch.
bazel_dep(name = "yaml-cpp", version = "0.9.0")

# 0.3.0 is the first release compatible with rules_cc 0.2.x (gets CcInfo from
# @rules_cc rather than the removed global symbol).
bazel_dep(name = "rules_cuda", version = "0.3.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")

# Hermetic CUDA toolkit 13.0.2, matching libtorch's cu130 build. Unlike the old
# cu129 setup, the cu130 libtorch zip no longer bundles the CUDA runtime, so
# these are now *runtime* deps too (not headers-only): //third_party:cuda_runtime
# links the toolkit .so that libtorch_cuda.so DT_NEEDEDs. cudnn/cusparseLt/nccl/
# nvshmem aren't in the toolkit redist -- see the @cudnn/@cusparselt/@nccl/
# @nvshmem http_archives below.
cuda.redist_json(
    name = "cuda_redist",
    components = [
        "cccl",
        "crt",  # required by the hermetic nvcc toolchain
        "cublas",  # libcublas.so.13 + libcublasLt.so.13
        "cudart",  # libcudart.so.13
        "cufft",  # libcufft.so.12
        "culibos",  # libculibos.a, split out of cudart in CUDA 13 (@cuda//:culibos_a)
        "cupti",  # libcupti.so.13
        "curand",  # libcurand.so.10
        "cusolver",  # libcusolver.so.12
        "cusparse",  # libcusparse.so.12
        "nvcc",
        "nvvm",  # required by the hermetic nvcc toolchain (CUDA 13+)
        "nvjitlink",  # libnvJitLink.so.13 (cublasLt dep)
        "nvrtc",  # libnvrtc.so.13
        "nvtx",
    ],
    version = "13.0.2",
)
cuda.toolkit(
    name = "cuda",
    toolkit_path = "",
)
use_repo(cuda, "cuda")

# cuDNN / cuSPARSELt / NCCL / NVSHMEM: hard DT_NEEDED by libtorch_cuda.so but NOT
# part of the CUDA toolkit redist, so rules_cuda can't provide them. (cufile IS in
# the toolkit redist, but rules_cuda generates no target for it -- registry.bzl
# maps "cufile" to [] -- so we fetch it the same way.) Pin the exact versions torch
# 2.12.0+cu130 was built against (from the wheel's Requires-Dist). All are NVIDIA
# redist .tar.xz except NCCL, which NVIDIA ships only as a wheel.
http_archive(
    name = "cufile",
    urls = ["https://developer.download.nvidia.com/compute/cuda/redist/libcufile/linux-x86_64/libcufile-linux-x86_64-1.15.1.6-archive.tar.xz"],
    strip_prefix = "libcufile-linux-x86_64-1.15.1.6-archive",
    integrity = "sha256-LB9USrGw4hVZDZQ8vRsKGSoGbpt1kuYFwuKLIuiGaI8=",
    build_file = "//third_party:cufile.BUILD",
)
http_archive(
    name = "cudnn",
    urls = ["https://developer.download.nvidia.com/compute/cudnn/redist/cudnn/linux-x86_64/cudnn-linux-x86_64-9.20.0.48_cuda13-archive.tar.xz"],
    strip_prefix = "cudnn-linux-x86_64-9.20.0.48_cuda13-archive",
    integrity = "sha256-c/CR7ldmjcGOixthgRwN3/LsC3Yu/mE+nyf56/1sIMA=",
    build_file = "//third_party:cudnn.BUILD",
)
http_archive(
    name = "cusparselt",
    urls = ["https://developer.download.nvidia.com/compute/cusparselt/redist/libcusparse_lt/linux-x86_64/libcusparse_lt-linux-x86_64-0.8.1.1_cuda13-archive.tar.xz"],
    strip_prefix = "libcusparse_lt-linux-x86_64-0.8.1.1_cuda13-archive",
    integrity = "sha256-gt0+XrwZmicBH1iFeoDNgl53u6Y0qyKGuj1OExFduJo=",
    build_file = "//third_party:cusparselt.BUILD",
)
http_archive(
    name = "nccl",
    urls = ["https://files.pythonhosted.org/packages/67/f4/58e4e91b6919367c7aafb8e36fce9aad1a3047e536bf7e2fd560927d3a4c/nvidia_nccl_cu13-2.29.7-py3-none-manylinux_2_18_x86_64.whl"],
    type = "zip",  # a wheel is a zip; NVIDIA ships NCCL no other hermetic way
    integrity = "sha256-7dgVOERnhuw7c5clQ+U7tDvK8L/I73bLZ5/MOQ/+E20=",
    build_file = "//third_party:nccl.BUILD",
)
http_archive(
    name = "nvshmem",
    urls = ["https://developer.download.nvidia.com/compute/nvshmem/redist/libnvshmem/linux-x86_64/libnvshmem-linux-x86_64-3.4.5_cuda13-archive.tar.xz"],
    strip_prefix = "libnvshmem-linux-x86_64-3.4.5_cuda13-archive",
    integrity = "sha256-GPEoB8I7xbJwWBrx+br9VANp2ng+VXFxVYiHYj13hCw=",
    build_file = "//third_party:nvshmem.BUILD",
)

# .bcr.2 carries the registry patches for Bazel 9 / rules_cc 0.2.x, dropping the
# git_override.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
