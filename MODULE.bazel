"""
ALE libtorch PPO
"""
module(
    name = "ale_libtorch_ppo",
    version = "0.1.0",
)

bazel_dep(name = "protobuf", version = "33.4")

bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_foreign_cc", version = "0.15.0")

tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
tools.cmake(version = "3.31.1")

bazel_dep(name = "zlib", version = "1.3.1.bcr.6")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "arcade_learning_environment",
    urls = ["https://github.com/Farama-Foundation/Arcade-Learning-Environment/archive/refs/tags/v0.11.1.tar.gz"],
    strip_prefix = "Arcade-Learning-Environment-0.11.1",
    build_file = "//third_party:ale.BUILD",
    integrity = "sha256-K4eK4bf+u0mMerU1F5HG2YONwhS0gl7sDfG1O1i2qqM=",
)

bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "tensorboard_logger")
git_override(
    module_name = "tensorboard_logger",
    # This commit loads the proto/cc rules explicitly (Bazel 9 / rules_cc 0.2.x
    # removed the native proto_library, cc_proto_library, cc_library and cc_test
    # rules) and declares its own rules_cc dep, so no patch is needed here.
    commit = "50889bf5c6502828a50a5a25edd2ca0b72f6f4cc",
    remote = "https://github.com/cemlyn007/tensorboard_logger.git",
)

bazel_dep(name = "stb", version = "0.0.0-20241109-5c20573")

libtorch_extension = use_extension("//third_party:libtorch.bzl", "libtorch_configure_extension")
libtorch_extension.configure(
    version = "2.4.1",  # Specify your desired version here
)
use_repo(libtorch_extension, "libtorch")

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    # The helly25 fork loads py_binary / cc_binary from @rules_python / @rules_cc
    # (Bazel 9 removed the native rules) and, in refresh.template.py, returns
    # sourceless compile actions (e.g. Bazel's -xc++-header parse_headers actions)
    # as a dropped action instead of tripping `assert source_file_candidates`.
    # So neither an autoload workaround nor our refresh patch is needed here.
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
    commit = "26a1ba52bd76aa3d95fa7278a9696d51f7946612",
)

# yaml-cpp 0.9.0 loads its rules via @rules_cc and includes <cstdint> in
# emitterutils.cpp, so neither the autoload workaround nor our force-include
# patch is needed anymore.
bazel_dep(name = "yaml-cpp", version = "0.9.0")

# rules_cuda 0.3.0 loads CcInfo from @rules_cc//cc/common:cc_info.bzl, required
# for compatibility with rules_cc 0.2.x (the global CcInfo symbol was removed).
bazel_dep(name = "rules_cuda", version = "0.3.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")

# Use a hermetic, downloadable CUDA toolkit instead of a local install. The
# version matches the CUDA build of libtorch (cu124). Only the components needed
# to compile against the CUDA headers are fetched; cudart's headers transitively
# require the nvcc and cccl headers.
cuda.redist_json(
    name = "cuda_redist",
    components = [
        "cccl",
        "cublas",
        "cudart",
        "cusolver",
        "cusparse",
        "nvcc",
        "nvrtc",
        "nvtx",
    ],
    # This redist is COMPILE-TIME ONLY: it provides the CUDA headers that
    # libtorch's ATen/cuda/CUDAContextLight.h (reachable from train.h) pulls in
    # -- cublas_v2.h, cublasLt.h, cusolverDn.h, cusparse.h, plus the cudart,
    # nvcc and cccl headers they transitively require.
    #
    # It is NOT used at runtime. libtorch is self-contained for the CUDA
    # runtime: it bundles its own CUDA libraries (under auditwheel-hashed
    # filenames) and third_party/libtorch.bzl recreates the canonical soname
    # symlinks so the libraries we link resolve them. Do not add these redist
    # libraries as runtime/link deps -- that would ship a second, redundant copy
    # of the CUDA runtime alongside libtorch's.
    version = "12.4.1",
)
cuda.toolkit(
    name = "cuda",
    toolkit_path = "",
)
use_repo(cuda, "cuda")

# 1.17.0.bcr.2 carries the registry-side patches that make googletest build
# under Bazel 9 / rules_cc 0.2.x, so no git_override is needed.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
